<?xml version="1.0" encoding="utf-8"?>
<!--
   Exclude session prefs so JWT / profile session data is not included in Auto Backup.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="stockflow_session.xml" />
    <exclude domain="sharedpref" path="stockflow_session_encrypted.xml" />
</full-backup-content>
