<?xml version="1.0" encoding="utf-8"?>
<!--
   Exclude session prefs from cloud backup and device transfer.
   See https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="stockflow_session.xml" />
        <exclude domain="sharedpref" path="stockflow_session_encrypted.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="stockflow_session.xml" />
        <exclude domain="sharedpref" path="stockflow_session_encrypted.xml" />
    </device-transfer>
</data-extraction-rules>
