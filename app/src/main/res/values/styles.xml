<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ExpandedTitleStyle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="fontFamily">sans-serif-black</item>
    </style>

    <style name="CollapsedTitleStyle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="fontFamily">sans-serif-black</item>
    </style>

    <!-- White sheet cards: rounded top, sharp bottom edges -->
    <style name="ShapeAppearanceOverlay.StockFlow.SheetCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Soft secondary filled button: navy+green in light, green-tint+bright green in dark -->
    <style name="Widget.StockFlow.SoftActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/soft_action_button_bg</item>
        <item name="android:textColor">@color/soft_action_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="SettingsSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/brand_text_light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
</resources>
