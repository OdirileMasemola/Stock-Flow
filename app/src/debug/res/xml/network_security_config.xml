<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug only. Release uses src/main and denies cleartext.
    HTTP is limited to the local backend hosts used during development.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator → host machine loopback -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Physical device → this PC on Wi-Fi (update if your LAN IP changes) -->
        <domain includeSubdomains="false">10.198.132.188</domain>
        <!-- Optional localhost aliases -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
