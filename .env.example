# Copy values into .env.local. Do not commit secrets.

DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://localhost:5432/stockflow_db
DB_USER=postgres
DB_PASSWORD=your_database_password

JWT_SECRET=change-me
JWT_ISSUER=com.example.stockflow
JWT_AUDIENCE=stockflow-users
JWT_EXPIRATION=3600000

# Optional: Firebase Admin service-account JSON (fallback only).
# Google Sign-In works without this — the API verifies Google ID tokens directly.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Must match the Android app Web client ID (requestIdToken / google_web_client_id).
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Image storage (Part 3 Stage 2)
# Flow: Android multipart → Ktor → Storage provider → public URL → PostgreSQL
# Never store image binaries in PostgreSQL. Never put these keys in the Android app.
# ---------------------------------------------------------------------------

# Provider: local (disk + /uploads static) | supabase (recommended for production)
STORAGE_PROVIDER=local

# Local disk directory (used when STORAGE_PROVIDER=local)
UPLOADS_DIR=./backend/uploads

# Max upload size in bytes (default 5242880 = 5 MiB)
UPLOAD_MAX_BYTES=5242880

# Supabase Storage (required when STORAGE_PROVIDER=supabase)
# Create a PUBLIC bucket named stockflow-images (or override the name below).
# Recommended layout inside the bucket: products/  profiles/  businesses/
# Use public object URLs (not signed) so Coil can load images without extra tokens.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=stockflow-images
